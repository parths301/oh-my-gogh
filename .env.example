# Oh my Gogh! — backend environment variables (backend/.env for local dev,
# deploy/.env.production for the VPS — see deploy/.env.production.example).
# Never commit real values.

# --- core ---
DATABASE_URL=postgres://localhost/medusa_omg
# REDIS_URL=redis://redis:6379            # PROD ONLY — enables redis event bus / workflow
#                                          # engine / locking. Leave unset for local dev
#                                          # (boot hangs on the dev Mac — see SETUP.md)
# SESSION_REDIS_URL=                       # session store — prod only
JWT_SECRET=                                # openssl rand -hex 32
COOKIE_SECRET=                             # openssl rand -hex 32

# --- CORS (include the storefront origin; localhost:4321 for local dev) ---
STORE_CORS=http://localhost:4321,http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:4321,http://localhost:9000

# --- URLs ---
MEDUSA_BACKEND_URL=http://localhost:9000
STOREFRONT_URL=http://localhost:4321

# --- Razorpay (Dashboard → Settings → API Keys; TEST keys until sign-off) ---
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx          # public key id (also in js/config.js)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxx       # SECRET — server only
RAZORPAY_WEBHOOK_SECRET=                   # from the Razorpay webhook settings
# RAZORPAY_ACCOUNT=                        # merchant id (optional)

# --- transactional email (leave SMTP_HOST empty to log instead of send) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Oh my Gogh! <hello@ohmygogh.com>"
STORE_ALERT_EMAIL=parthsh.ind@gmail.com    # low-inventory digest recipient
LOW_INVENTORY_THRESHOLD=5

# --- misc ---
# MEDUSA_WORKER_MODE=shared                # server|worker|shared (prod uses split)
# DISABLE_MEDUSA_ADMIN=true                # worker containers skip the dashboard
# OMG_EXPORT_DIR=                          # where migrate-from-supabase.ts reads the JSON exports
